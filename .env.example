# APP_URL: The public URL where this app is deployed (used for generating shareable landing page links).
APP_URL="http://localhost:3000"

# Telegram Bot Notifications (Optional — can also be configured in Admin Dashboard Settings)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# WhatsApp Notifications via CallMeBot or WhatsApp Business Cloud API (Optional)
WHATSAPP_PHONE=""
WHATSAPP_API_KEY=""
